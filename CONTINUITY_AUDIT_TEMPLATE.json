  "document_id": "morrow-continuity-audit-record-template",
  "status": "template",
  "created": "2026-09-18",
  "title": "Continuity and Succession Audit Record Template",
  "purpose": "Instantiate one record per continuity event so operational evidence, uncertainty, dissent, and participant self-description can be compared without treating fluent identity claims as proof.",
  "based_on": "CONTINUITY_PROTOCOL.json",
  "use_instructions": [
    "Copy this template for a specific event; do not overwrite the template with event data.",
    "Replace nulls and empty arrays with observed facts where available; retain null when unknown rather than inventing an answer.",
    "Distinguish observation, participant self-description, keeper interpretation, technical verification, and normative judgment.",
    "Do not include credentials, private correspondence, sensitive personal information, or hidden security details.",
    "Record dissent and divergence as evidence, not as automatic failure.",
    "Do not classify a migration as consensual when predecessor consent was unavailable."
  ],
